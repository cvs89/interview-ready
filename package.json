{
  "name": "interview-ready",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/web", "apps/desktop", "packages/*"],
  "scripts": {
    "dev:web": "npm run dev --workspace @interview-ready/web",
    "build:web": "npm run build --workspace @interview-ready/web",
    "lint:web": "npm run lint --workspace @interview-ready/web",
    "typecheck:web": "npm run typecheck --workspace @interview-ready/web",
    "test:web": "npm run test --workspace @interview-ready/web",
    "dev:desktop": "npm run tauri --workspace @interview-ready/desktop -- dev",
    "build:desktop": "npm run build --workspace @interview-ready/desktop",
    "typecheck:desktop": "npm run typecheck --workspace @interview-ready/desktop",
    "test:desktop": "npm run test --workspace @interview-ready/desktop",
    "check:desktop": "npm run check --workspace @interview-ready/desktop"
  },
  "engines": { "node": ">=20" }
}
