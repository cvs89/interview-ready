# ------------------------------------------------------------------------------
# Next.js web app (apps/web) for Cloud Run.
#
# Build context MUST be the repository root, because apps/web imports the
# workspace package @interview-ready/api-types from packages/.
# Cloud Run console: Build type = Dockerfile, Source location = /Dockerfile.web
# ------------------------------------------------------------------------------

# Stage 1: Install workspace dependencies from the root lockfile
FROM node:22-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
COPY apps/desktop/package.json apps/desktop/
COPY packages/api-types/package.json packages/api-types/
COPY packages/config/package.json packages/config/
COPY packages/ui/package.json packages/ui/

RUN npm ci --no-audit --no-fund

# Stage 2: Build Next.js (standalone output)
FROM node:22-alpine AS builder
WORKDIR /app

COPY --from=deps /app ./
COPY packages ./packages
COPY apps/web ./apps/web

# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time,
# so the backend URL must be known here (setting it on Cloud Run later has no effect).
ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production

RUN npm run build --workspace @interview-ready/web

# Stage 3: Minimal runtime
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=8080 \
    HOSTNAME=0.0.0.0

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# outputFileTracingRoot = repo root, so server.js lives at apps/web/server.js
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public

USER nextjs
EXPOSE 8080

CMD ["node", "apps/web/server.js"]
