# Copy values deliberately into your local .env; do not overwrite existing secrets.
APP_ENV=development
DATABASE_BACKEND=firestore
FIRESTORE_PROJECT_ID=demo-interview-ready
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_SCAN_LIMIT=1000
# Export this in your shell too: the Google SDK reads process environment.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
REDIS_URL=redis://localhost:6379/0
WEB_ORIGINS=http://localhost:3000
PAYMENT_PROVIDER=mock
# Firebase Authentication is unchanged. Use your existing auth configuration.
# Hosted Firestore: unset FIRESTORE_EMULATOR_HOST and use ADC + the real project ID.
