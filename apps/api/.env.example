APP_ENV=development
LOG_LEVEL=INFO
# Choose firestore to use Firestore; see .env.firestore.example and docs/FIRESTORE_MIGRATION.md.
DATABASE_BACKEND=postgresql
DATABASE_URL=postgresql+asyncpg://interview_ready:local_only_password@localhost:5432/interview_ready
REDIS_URL=redis://localhost:6379/0
WEB_ORIGINS=http://localhost:3000
# Local Firebase Admin uses Application Default Credentials. Never commit the JSON file.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json

# Payment Provider Configuration
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
