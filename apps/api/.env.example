APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://interview_ready:local_only_password@localhost:5432/interview_ready
REDIS_URL=redis://localhost:6379/0
WEB_ORIGINS=http://localhost:3000
# Local Firebase Admin uses Application Default Credentials. Never commit the JSON file.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
