{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Interview Ready",
  "version": "0.1.0",
  "identifier": "com.interviewready.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Interview Ready",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:8000 https://*.livekit.cloud wss://*.livekit.cloud; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; media-src 'self' blob: data:;"
    }
  },
  "plugins": {
    "deep-link": {
      "schemes": ["interviewapp"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}

